// Cloudflare Workers deployment: see DEPLOY.md.
{
  "name": "unofficho",
  "compatibility_date": "2026-10-01",
  // Handles /api/* only (suggestions); everything else is served straight from ./dist.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // No automatic fallback: the Worker decides between the app shell (client-only routes such as
    // /calc) and a real 404 page, so unknown addresses are not served as the homepage with 200.
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Suggestions sent from the app. With no database_id, the first deploy creates the database
  // (Wrangler's automatic provisioning). See DEPLOY.md for reading them.
  "d1_databases": [{ "binding": "DB", "database_name": "unofficho-feedback" }],
  "observability": { "enabled": true }
}
